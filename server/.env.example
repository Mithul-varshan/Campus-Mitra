# ==============================================================================
# CampusMithra Server Environment Configuration
# ==============================================================================

# Server Port & Allowed Client CORS Origin
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# GitHub Integration (OAuth & API Proxy)
# ------------------------------------------------------------------------------
# Optional: Personal Access Token (PAT) for higher rate limits (5,000 req/hr vs 60/hr)
GITHUB_API_TOKEN=
# GitHub OAuth App credentials (for student login & profile sync)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ------------------------------------------------------------------------------
# TiDB Cloud (Serverless MySQL Compatible Database)
# ------------------------------------------------------------------------------
# Obtain these from your TiDB Cloud Cluster dashboard -> Connect -> General
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_cluster_prefix.root
DB_PASS=your_tidb_password_here
DB_NAME=campusmithra

# ------------------------------------------------------------------------------
# LeetCode API Service
# ------------------------------------------------------------------------------
# Local Docker instance: docker run -d -p 3000:3000 alfaarghya/alfa-leetcode-api:2.0.4
# Remote fallback automatically engaged if local container is unreachable
LEETCODE_API_URL=http://localhost:3000
